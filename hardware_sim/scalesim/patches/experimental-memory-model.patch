new file mode 100644
index 0000000..47c7a0a
--- /dev/null
+++ b/tests/test_read_buffer_trace_chunks.py
@@ -0,0 +1,93 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from scalesim.memory.read_buffer import read_buffer
+
+
+class TestReadBufferTraceChunks(unittest.TestCase):
+
+    def make_buffer(self):
+        buf = read_buffer.__new__(read_buffer)
+        buf.trace_valid = True
+        buf.trace_matrix = np.array([
+            [10, 100],
+            [11, 101],
+        ])
+        buf._trace_chunks = [
+            np.array([[20, 200], [21, 201]]),
+            np.array([[30, 300]]),
+        ]
+        return buf
+
+    def expected_trace(self):
+        return np.array([
+            [10, 100],
+            [11, 101],
+            [20, 200],
+            [21, 201],
+            [30, 300],
+        ])
+
+    def test_trace_order_and_contents(self):
+        buf = self.make_buffer()
+
+        np.testing.assert_array_equal(
+            buf.get_trace_matrix(),
+            self.expected_trace()
+        )
+
+        self.assertEqual(len(buf._trace_chunks), 0)
+
+    def test_repeated_materialization(self):
+        buf = self.make_buffer()
+
+        first = buf.get_trace_matrix().copy()
+        second = buf.get_trace_matrix()
+
+        np.testing.assert_array_equal(first, second)
+
+        buf._trace_chunks.append(np.array([[40, 400]]))
+
+        expected = np.vstack([
+            self.expected_trace(),
+            [[40, 400]]
+        ])
+
+        np.testing.assert_array_equal(
+            buf.get_trace_matrix(),
+            expected
+        )
+
+    def test_external_access_cycles(self):
+        buf = self.make_buffer()
+
+        start, end = (
+            buf.get_external_access_start_stop_cycles()
+        )
+
+        self.assertEqual(start, 10)
+        self.assertEqual(end, 30)
+
+    def test_export_contains_all_chunks(self):
+        buf = self.make_buffer()
+
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "trace.csv"
+            buf.print_trace(str(path))
+
+            exported = np.loadtxt(
+                path,
+                delimiter=","
+            )
+
+            np.testing.assert_array_equal(
+                exported,
+                self.expected_trace()
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
