@@ -0,0 +1,88 @@
+"""EXPERIMENTAL exact active-window membership for SCALE-Sim v3 read_buffer.
+
+Non-layout path only. Preserves original prefetch timings and request generation;
+replaces the rounded hashed-set membership test with a Counter over the exact
+prefetched addresses still resident in the fixed-capacity active window.
+
+This is a debug experiment, not a fully verified hardware cache model.
+"""
+from collections import Counter, deque
+import numpy as np
+
+
+def install_exact_window(cls):
+    """Install once; requires the previously tested _take_prefetch_words patch."""
+    if getattr(cls, '_exact_window_installed', False):
+        return
+    if not hasattr(cls, '_take_prefetch_words'):
+        raise RuntimeError(
+            'Exact-window experiment requires the validated _take_prefetch_words '
+            'method. Use your scale-sim-v3-debug checkout, not an unmodified tree.'
+        )
+
+    old_take = cls._take_prefetch_words
+    old_initial = cls.prefetch_active_buffer
+    old_refill = cls.new_prefetch
+    old_hit = cls.active_buffer_hit
+
+    def take(self, requested_words):
+        requests = old_take(self, requested_words)
+        # Record what the request generator actually handed to the backing port.
+        # Ignore -1 padding, not real addresses >= 0.
+        self._exact_last_prefetch = [
+            int(x) for x in np.asarray(requests).flat if x >= 0
+        ]
+        return requests
+
+    def initial(self, start_cycle):
+        self._exact_last_prefetch = None
+        response = old_initial(self, start_cycle=start_cycle)
+        if not self.enable_layout_evaluation:
+            values = self._exact_last_prefetch
+            if values is None:
+                raise RuntimeError('Initial prefetch did not use _take_prefetch_words')
+            if len(values) > self.active_buf_size:
+                raise RuntimeError('Initial prefetch exceeds active-buffer capacity')
+            self._exact_active_queue = deque(values)
+            self._exact_active_counts = Counter(values)
+        return response
+
+    def refill(self):
+        self._exact_last_prefetch = None
+        response = old_refill(self)
+        if not self.enable_layout_evaluation:
+            values = self._exact_last_prefetch
+            if values is None:
+                raise RuntimeError('Refill did not use _take_prefetch_words')
+            if not values:
+                raise RuntimeError('Refill fetched zero valid addresses')
+            queue = getattr(self, '_exact_active_queue', None)
+            counts = getattr(self, '_exact_active_counts', None)
+            if queue is None or counts is None:
+                raise RuntimeError('Refill before initial active-buffer load')
+            for address in values:
+                if len(queue) >= self.active_buf_size:
+                    evicted = queue.popleft()
+                    counts[evicted] -= 1
+                    if counts[evicted] == 0:
+                        del counts[evicted]
+                queue.append(address)
+                counts[address] += 1
+            if len(queue) > self.active_buf_size:
+                raise AssertionError('Exact active buffer exceeded its capacity')
+        return response
+
+    def hit(self, addr):
+        if self.enable_layout_evaluation:
+            return old_hit(self, addr)
+        assert self.active_buf_full_flag, 'Active buffer is not ready yet'
+        counts = getattr(self, '_exact_active_counts', None)
+        if counts is None:
+            raise RuntimeError('Exact active membership uninitialized')
+        return counts.get(int(addr), 0) > 0
+
+    cls._take_prefetch_words = take
+    cls.prefetch_active_buffer = initial
+    cls.new_prefetch = refill
+    cls.active_buffer_hit = hit
+    cls._exact_window_installed = True
